# Caddy слушает plain HTTP :80 внутри контейнера. TLS и домен — на системном
# nginx перед контейнером (reverse proxy на 127.0.0.1:8080 + certbot).
:80 {
	encode gzip zstd

	# API, WebSocket и загруженные файлы — на backend (Caddy сам апгрейдит WS)
	@backend path /api/* /socket.io/* /uploads/*
	handle @backend {
		reverse_proxy backend:4000
	}

	# Остальное — статика SPA (fallback на index.html для клиентского роутинга)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
