# ═══════════════════════════════════════════════
# VOVPLAN — Environment Variables
# ═══════════════════════════════════════════════

# Backend
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
# DEV: не используется — Prisma работает на SQLite (packages/backend/prisma/dev.db),
#      Docker не нужен. PROD: PostgreSQL + PostGIS (см. infrastructure/docker-compose.yml).
DATABASE_URL="postgresql://vovplan:vovplan@localhost:5432/vovplan?schema=public"

# Redis — только для прода (очереди обработки моделей). В dev не используется.
REDIS_URL="redis://localhost:6379"

# S3 / MinIO не используется: файлы лежат в ./uploads и раздаются подписанными
# ссылками — и в разработке, и на проде. Переменные убраны, чтобы пароль в
# примере не выглядел настройкой, которую надо заполнить.

# JWT
JWT_SECRET="change-this-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

# CORS — origins фронтенда через запятую
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Frontend (Vite читает из этого файла: envDir = корень монорепо)
# DEV: оставить пустым — фронт ходит на бэкенд через vite-прокси (/api, /socket.io),
#      это же позволяет открывать приложение по LAN-адресу с телефона.
# PROD: абсолютный URL API, например https://api.vovplan.io
VITE_API_URL=""
VITE_S3_URL=""

# ── Почта: подтверждение адреса и восстановление пароля ──
# Через SMTP, а не через API конкретного сервиса: SMTP есть у всех
# (Unisender, DashaMail, SendPulse, Яндекс 360, Mail.ru), и смена
# провайдера — это правка вот этих строк, а не кода.
#
# Пусто — письма НЕ отправляются, а печатаются в лог со ссылкой внутри.
# Так весь сценарий проходится локально, без единой внешней учётки.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VOVPLAN <noreply@vovplan.com>"

# Адрес, по которому сервис виден снаружи — из него собираются ссылки
# в письмах. Это адрес ФРОНТЕНДА: человек должен попасть на страницу,
# а не на голый ответ API.
PUBLIC_URL="http://localhost:5173"

# ── Вход через соцсети ──
# Пусто — кнопки на сайте нет. Redirect URI:
#   {PUBLIC_URL}/api/auth/oauth/<google|yandex|facebook|vk|wechat>/callback
# Telegram: @BotFather → /setdomain (домен без https).
# VK: кабинет VK ID https://id.vk.ru — ID приложения + сервисный ключ, не oauth.vk.com.
# Китай: WeChat Open Platform, вход QR (snsapi_login), не Mini Program.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
