# ── VOVPLAN production — скопируйте в .env на сервере и заполните ──

# Домен для Caddy (авто-TLS Let's Encrypt). Для локального теста без домена: :80
SITE_ADDRESS=vovplan.com, www.vovplan.com

# CORS — с каких origin можно обращаться к API (https + ваш домен)
CORS_ORIGINS=https://vovplan.com,https://www.vovplan.com

# PostgreSQL
POSTGRES_DB=vovplan
POSTGRES_USER=vovplan
POSTGRES_PASSWORD=CHANGE_ME_надёжный_пароль

# JWT — длинный случайный секрет. Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# Почта писем (подтверждение адреса и сброс пароля).
# Тот же ящик, что у КП на api.vovarch.ru: Яндекс, info@vovarch.ru.
# Пароль — только в .env на сервере, в git не класть.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=info@vovarch.ru
SMTP_PASS=
SMTP_FROM=VOVPLAN <info@vovarch.ru>

# Ссылки внутри писем — адрес сайта, не API
PUBLIC_URL=https://vovplan.com

# Первый хозяин на пустой базе. Почта, под которой вы зарегистрируетесь.
# Выдаёт права только если администраторов ещё нет; повторный пуск ничего
# не меняет. Во фронт и в ответы API не попадает.
BOOTSTRAP_ADMIN_EMAIL=

# ── Вход через соцсети ──
# Пусто — кнопки на сайте нет. Redirect:
#   https://vovplan.com/api/auth/oauth/<google|yandex|facebook|vk|wechat>/callback
# Telegram: @BotFather → /setdomain vovplan.com
# VK: кабинет VK ID (id.vk.ru) — ID приложения + сервисный ключ
# Китай: WeChat Open Platform (QR snsapi_login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
